{
  "App": {
    "SelfUrl": "https://localhost:44321",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.TodoApp.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../TodoApp.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44321",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "TodoApp_Swagger",
    "CertificatePassPhrase": "8ad0880f-ca03-4ec2-8cfd-15a87f5fb902"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "i0iPG2zZF6vjV7J3"
  }}